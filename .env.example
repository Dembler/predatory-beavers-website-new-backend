APP_NAME=Predatory Beavers API
APP_VERSION=0.1.0
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true
APP_API_PREFIX=/api/v1
APP_DATABASE_URL=postgresql+asyncpg://predatory_beavers:predatory_beavers@localhost:5432/predatory_beavers
APP_DATABASE_ECHO=false
APP_CORS_ORIGINS=["http://localhost:5173"]
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true
APP_SESSION_COOKIE_NAME=pb_session
APP_SESSION_TTL_SECONDS=43200
APP_COOKIE_SECURE=false
APP_CSRF_HEADER_NAME=X-CSRF-Token
APP_AUTH_LOGIN_MAX_ATTEMPTS=10
APP_AUTH_LOGIN_WINDOW_SECONDS=60
APP_AUTH_LOGIN_MAX_CONCURRENCY=4
APP_AUTH_MAX_ACTIVE_SESSIONS=5
