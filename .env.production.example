# Server-only configuration. Copy to an ignored local file, never commit secrets.
# docker compose --env-file .env.production -f compose.production.yaml up -d --build
# A persistent /app/data volume and an HTTPS reverse proxy are required.
# Do not run an extra API replica against this SQLite volume.
# APP_* values also document direct process/container deployment. Compose uses
# fixed values or application defaults for env/host/port/prefix/reload, DB URL/echo,
# media paths, sync enable/root and cookie security/name; changing those values here does not
# override compose.production.yaml. Compose uses the tuning variables referenced
# in ${...} there. compose.https.yaml overrides trusted proxy IPs with its CIDR.
# Optional compose.https.yaml proxy; set DNS to your server before starting it.
API_DOMAIN=api.club.example
# Optional dedicated bridge; change if this private subnet overlaps another network.
PB_PROXY_SUBNET=172.30.250.0/24
APP_PUBLIC_ORIGIN=https://club.example
APP_ENV=prod
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=false
APP_TRUSTED_PROXY_IPS=127.0.0.1
APP_API_PREFIX=/api/v1
APP_DATABASE_URL=sqlite+aiosqlite:////app/data/local.db
APP_DATABASE_ECHO=false
APP_DATABASE_BUSY_TIMEOUT_MS=5000
APP_MEDIA_STORAGE_PATH=/app/data/media

APP_COOKIE_SECURE=true
APP_SESSION_COOKIE_NAME=__Host-pb_session
APP_SESSION_TTL_SECONDS=43200
# Prefer a shared custom domain for the site and API and keep lax.
# Unrelated sites (github.io + a hosting-provider domain) require none for cookies.
# none also requires HTTPS; browsers may still block these third-party cookies.
# Changing CORS/SameSite alone cannot guarantee cross-site administrator login.
APP_COOKIE_SAMESITE=lax
# For direct container/process deployment, keep this exact origin in sync above.
# Compose generates this setting from APP_PUBLIC_ORIGIN; no path or trailing slash.
APP_CORS_ORIGINS=["https://club.example"]

APP_SPORTS_SYNC_ENABLED=true
APP_SPORTS_SYNC_BACKEND_ROOT=/app
APP_SPORTS_SYNC_INTERVAL_SECONDS=3600
APP_SPORTS_SYNC_FIBA_INTERVAL_SECONDS=86400
APP_SPORTS_SYNC_TIMEOUT_SECONDS=600
# Optional official FIBA API access. This key must never reach frontend variables.
APP_FIBA_API_KEY=
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true
# Public health probes: GET /health/live and GET /health/ready on port 8000.
# ready checks the database; use a 20 s startup grace, 30 s period, 5 s timeout.
