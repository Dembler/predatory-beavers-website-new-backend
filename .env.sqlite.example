APP_NAME=Predatory Beavers API
APP_VERSION=0.1.0
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=true
APP_API_PREFIX=/api/v1
APP_DATABASE_URL=sqlite+aiosqlite:///./data/predatory_beavers.db
APP_DATABASE_ECHO=false
APP_DATABASE_BUSY_TIMEOUT_MS=5000
APP_MEDIA_STORAGE_PATH=data/media
APP_MEDIA_MAX_UPLOAD_BYTES=8388608
APP_MEDIA_MAX_DIMENSION=4096
APP_MEDIA_WEBP_QUALITY=85
APP_ASB_ENABLED=false
APP_ASB_BASE_URL=https://asb.infobasket.su
APP_ASB_ALLOWED_HOSTS=["asb.infobasket.su"]
APP_ASB_ALLOWED_COMPETITION_IDS=[]
APP_ASB_ALLOWED_TEAM_IDS=[]
APP_ASB_TIMEOUT_SECONDS=10
APP_ASB_MAX_RESPONSE_BYTES=2097152
APP_ASB_MAX_GAMES=500
APP_CORS_ORIGINS=["http://localhost:5173"]
APP_LOG_LEVEL=INFO
APP_LOG_JSON=false
APP_SESSION_COOKIE_NAME=pb_session
APP_SESSION_TTL_SECONDS=43200
APP_COOKIE_SECURE=false
APP_CSRF_HEADER_NAME=X-CSRF-Token
APP_AUTH_LOGIN_MAX_ATTEMPTS=10
APP_AUTH_LOGIN_WINDOW_SECONDS=60
APP_AUTH_LOGIN_MAX_CONCURRENCY=4
APP_AUTH_MAX_ACTIVE_SESSIONS=5
