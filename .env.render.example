# Import in Render with "Add from .env" after replacing the three Supabase values.
# Server settings only. Never put this populated file or its keys in GitHub or VITE_*.
APP_ENV=prod
APP_RELOAD=false
APP_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require
APP_DATABASE_SCHEMA=beavers
APP_DATABASE_POOL_SIZE=3
APP_DATABASE_MAX_OVERFLOW=1
APP_MEDIA_STORAGE_BACKEND=supabase
APP_SUPABASE_URL=https://PROJECT_REF.supabase.co
APP_SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
APP_SUPABASE_STORAGE_BUCKET=club-media
APP_COOKIE_SECURE=true
APP_COOKIE_SAMESITE=none
APP_SESSION_COOKIE_NAME=__Host-pb_session
APP_CORS_ORIGINS=["https://dembler.github.io"]
APP_SPORTS_SYNC_ENABLED=false
APP_SPORTS_SYNC_EXTERNAL_ENABLED=true
APP_SPORTS_SYNC_CACHE_PATH=/app/data/sports-sync
APP_SPORTS_SYNC_INTERVAL_SECONDS=3600
APP_SPORTS_SYNC_FIBA_INTERVAL_SECONDS=86400
APP_SPORTS_SYNC_BACKEND_ROOT=/app
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true
