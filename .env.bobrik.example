# Copy to .env.bobrik (gitignored). Used only by scripts/bobrik_local.py.
# Paid DeepSeek through the owner's OpenCode Go subscription.
APP_MASCOT_ENABLED=true
APP_LLM_PROVIDER=opencode
APP_LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
APP_LLM_API_KEY=
APP_LLM_CHAT_MODEL=deepseek-v4.1-flash
APP_LLM_EDITOR_MODEL=deepseek-v4.1-flash
APP_LLM_BUDGET_MODE=unlimited
APP_CHAT_DEADLINE_SECONDS=20
APP_CHAT_MAX_INPUT_CHARS=1000
APP_CHAT_MAX_OUTPUT_TOKENS=500
